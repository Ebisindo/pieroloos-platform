# PostgreSQL connection used by Prisma
DATABASE_ENV=local
DATABASE_URL_LOCAL="postgresql://USER:PASSWORD@localhost:5432/pierolo_local?schema=public"
# Must be separate and disposable; Prisma resets it for migration-history checks.
SHADOW_DATABASE_URL_LOCAL="postgresql://USER:PASSWORD@localhost:5432/pierolo_shadow?schema=public"
# Configure staging and production URLs in deployment secret management; do not store their credentials in this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OPERATIONAL_WORKER_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_MESSAGE_ID_DOMAIN=""
DOCUMENT_SCANNER_WEBHOOK_SECRET=""
# Private S3-compatible document bucket; use a bucket with public access disabled.
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION="AES256"
OBJECT_STORAGE_KMS_KEY_ID=""
# Authentication (NextAuth v4). See docs/AUTH-SETUP.md.
# Canonical public origin (production: https://YOUR-DOMAIN, no trailing slash).
NEXTAUTH_URL="http://localhost:3000"
# Required. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret"
OIDC_ISSUER="https://identity.example.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="Organization SSO"
# GitHub OAuth App; callback: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""
# Development only; requires an existing staff user with organization membership.
# Ignored unless NODE_ENV=development and LOCAL_AUTH_ENABLED=true.
LOCAL_AUTH_ENABLED="false"
LOCAL_AUTH_EMAIL=""
LOCAL_AUTH_PASSWORD=""
# Comma-separated email addresses; each must also have an organization membership.

# Optional: receives a content-free alert for new partnership inquiries (requires SMTP_*).
PARTNERSHIP_INQUIRY_NOTIFY_EMAIL=""

# Public origin used for canonical URLs, sitemap and structured data (e.g. https://example.com). Leave unset to omit them.
SITE_URL=""


# Payment gateway: all payment methods remain disabled until explicitly configured and verified.
PAYMENTS_ENABLED="false"
STRIPE_PAYMENTS_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Configure these in the secret manager, never commit real values.
BANK_TRANSFER_ENABLED="false"
BANK_TRANSFER_DETAILS_VERIFIED="false"
BANK_TRANSFER_ACCOUNT_HOLDER=""
BANK_TRANSFER_BANK_NAME=""
BANK_TRANSFER_ACCOUNT_TYPE=""
BANK_TRANSFER_ACCOUNT_NUMBER=""
BANK_TRANSFER_ACH_ROUTING=""
BANK_TRANSFER_WIRE_ROUTING=""
BANK_TRANSFER_BANK_ADDRESS=""
BANK_TRANSFER_CURRENCY="USD"
BANK_TRANSFER_SUPPORTED_SENDING_REGION="US"
BANK_TRANSFER_ACH_FEE_USD=""
BANK_TRANSFER_WIRE_FEE_USD=""
BANK_TRANSFER_PROCESSING_TIME=""

# Crypto review mode is manual; the application does not automatically query a blockchain.
CRYPTO_PAYMENTS_ENABLED="false"
CRYPTO_MANUAL_RECONCILIATION_ENABLED="false"
CRYPTO_USD_PARITY_QUOTE_APPROVED="false"
CRYPTO_USDT_TRON_ADDRESS=""
CRYPTO_USDT_TRON_ADDRESS_VERIFIED="false"
CRYPTO_USDT_TRON_TOKEN_ID=""
CRYPTO_USDT_TRON_TOKEN_ID_VERIFIED="false"
CRYPTO_USDT_TRON_TOKEN_DECIMALS=""
CRYPTO_USDT_TRON_TOKEN_DECIMALS_VERIFIED="false"
CRYPTO_USDT_BNB_SMART_CHAIN_ADDRESS=""
CRYPTO_USDT_BNB_SMART_CHAIN_ADDRESS_VERIFIED="false"
CRYPTO_USDT_BNB_SMART_CHAIN_TOKEN_ID=""
CRYPTO_USDT_BNB_SMART_CHAIN_TOKEN_ID_VERIFIED="false"
CRYPTO_USDT_BNB_SMART_CHAIN_TOKEN_DECIMALS=""
CRYPTO_USDT_BNB_SMART_CHAIN_TOKEN_DECIMALS_VERIFIED="false"
CRYPTO_USDC_ETHEREUM_ADDRESS=""
CRYPTO_USDC_ETHEREUM_ADDRESS_VERIFIED="false"
CRYPTO_USDC_ETHEREUM_TOKEN_ID=""
CRYPTO_USDC_ETHEREUM_TOKEN_ID_VERIFIED="false"
CRYPTO_USDC_ETHEREUM_TOKEN_DECIMALS=""
CRYPTO_USDC_ETHEREUM_TOKEN_DECIMALS_VERIFIED="false"
CRYPTO_USDC_SOLANA_ADDRESS=""
CRYPTO_USDC_SOLANA_ADDRESS_VERIFIED="false"
CRYPTO_USDC_SOLANA_MINT=""
CRYPTO_USDC_SOLANA_MINT_VERIFIED="false"
CRYPTO_USDC_SOLANA_TOKEN_DECIMALS=""
CRYPTO_USDC_SOLANA_TOKEN_DECIMALS_VERIFIED="false"
CRYPTO_USDC_BNB_SMART_CHAIN_ADDRESS=""
CRYPTO_USDC_BNB_SMART_CHAIN_ADDRESS_VERIFIED="false"
CRYPTO_USDC_BNB_SMART_CHAIN_TOKEN_ID=""
CRYPTO_USDC_BNB_SMART_CHAIN_TOKEN_ID_VERIFIED="false"
CRYPTO_USDC_BNB_SMART_CHAIN_TOKEN_DECIMALS=""
CRYPTO_USDC_BNB_SMART_CHAIN_TOKEN_DECIMALS_VERIFIED="false"
CRYPTO_TRON_ENABLED="false"
CRYPTO_BNB_SMART_CHAIN_ENABLED="false"
CRYPTO_ETHEREUM_ENABLED="false"
CRYPTO_SOLANA_ENABLED="false"

# Read-only mainnet RPC providers; supply HTTPS endpoints and credentials via secret management.
# Set the mainnet-verified flag only after independently checking the provider's actual network.
CRYPTO_TRON_RPC_URL=""
CRYPTO_TRON_RPC_API_KEY=""
CRYPTO_TRON_MAINNET_VERIFIED="false"
CRYPTO_TRON_MIN_CONFIRMATIONS=""
CRYPTO_BNB_SMART_CHAIN_RPC_URL=""
CRYPTO_BNB_SMART_CHAIN_MAINNET_VERIFIED="false"
CRYPTO_BNB_SMART_CHAIN_MIN_CONFIRMATIONS=""
CRYPTO_ETHEREUM_RPC_URL=""
CRYPTO_ETHEREUM_MAINNET_VERIFIED="false"
CRYPTO_ETHEREUM_MIN_CONFIRMATIONS=""
CRYPTO_SOLANA_RPC_URL=""
CRYPTO_SOLANA_MAINNET_VERIFIED="false"
CRYPTO_SOLANA_MIN_CONFIRMATIONS=""
