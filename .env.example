# PostgreSQL connection used by Prisma
DATABASE_ENV=local
DATABASE_URL_LOCAL="postgresql://USER:PASSWORD@localhost:5432/pierolo_local?schema=public"
# Must be separate and disposable; Prisma resets it for migration-history checks.
SHADOW_DATABASE_URL_LOCAL="postgresql://USER:PASSWORD@localhost:5432/pierolo_shadow?schema=public"
# Configure staging and production URLs in deployment secret management; do not store their credentials in this file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
OPERATIONAL_WORKER_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_MESSAGE_ID_DOMAIN=""
DOCUMENT_SCANNER_WEBHOOK_SECRET=""
# Private S3-compatible document bucket; use a bucket with public access disabled.
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_SERVER_SIDE_ENCRYPTION="AES256"
OBJECT_STORAGE_KMS_KEY_ID=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
OIDC_ISSUER="https://identity.example.com"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="Organization SSO"
GITHUB_ID=""
GITHUB_SECRET=""
# Comma-separated email addresses; each must also have an organization membership.
PLATFORM_SUPERADMIN_EMAILS=""
