# Authentication (NextAuth v4)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="Organization SSO"
# Development only; ignored unless NODE_ENV=development and LOCAL_AUTH_ENABLED=true.
LOCAL_AUTH_ENABLED="false"
LOCAL_AUTH_EMAIL=""
LOCAL_AUTH_PASSWORD=""

# Prisma / PostgreSQL
DATABASE_URL=""

# Firebase Authentication step-up (server-side only; do not commit actual credentials)
FIREBASE_PROJECT_ID="pieroloos-platform"
# Prefer Application Default Credentials / workload identity. If unavailable, use protected runtime secrets:
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Temporary per-local-user explicit UID map, configured only in protected hosting secrets; never map by email.
# FIREBASE_UID_MAP_<LOCAL_USER_ID>="firebase-uid"
