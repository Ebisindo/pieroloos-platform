// ADDITIVE SESSION 12 SCHEMA.
// Merge into the established prisma/schema.prisma.

enum OperationalActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  RESOLVED
  CANCELLED
}

enum OperationalActionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model OperationalAction {
  id String @id @default(cuid())
  organizationId String
  workspaceId String
  title String
  description String?

  sourceSignalId String?
  clientId String?
  engagementId String?
  documentId String?
  complianceObligationId String?

  assigneeUserId String?
  createdByUserId String

  priority OperationalActionPriority @default(NORMAL)
  status OperationalActionStatus @default(OPEN)

  dueAt DateTime?
  escalationLevel Int @default(0)
  escalationAt DateTime?

  resolvedAt DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, workspaceId, status])
  @@index([organizationId, workspaceId, dueAt])
  @@index([assigneeUserId, status, dueAt])
  @@index([sourceSignalId])
  @@index([complianceObligationId, status])
}

model OperationalEscalationEvent {
  id String @id @default(cuid())
  organizationId String
  workspaceId String
  actionId String
  fromLevel Int
  toLevel Int
  reason String
  occurredAt DateTime @default(now())

  @@index([organizationId, workspaceId, occurredAt])
  @@index([actionId, occurredAt])
}
