model BillingSubscription {
  id                    String                    @id @default(cuid())
  organizationId        String
  planId                String
  status                BillingSubscriptionStatus @default(ACTIVE)
  interval              BillingInterval           @default(MONTH)
  provider              String?
  providerSubscriptionId String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                   @default(false)
  canceledAt            DateTime?
  endedAt               DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BillingPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     BillingInvoice[]

  @@unique([provider, providerSubscriptionId])
  @@index([organizationId, status, currentPeriodEnd])
  @@index([planId])
}

model BillingUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  entitlementKey String
  quantity       Int
  unit           String?
  idempotencyKey String
  metadata       Json?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, entitlementKey, occurredAt])
  @@index([workspaceId, entitlementKey, occurredAt])
}

model BillingCreditEntry {
  id             String                @id @default(cuid())
  organizationId String
  workspaceId    String?
  entryType      BillingCreditEntryType
  direction      BillingCreditDirection
  amount         Int
  creditType     String
  idempotencyKey String
  reference      String?
  description    String?
  metadata       Json?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, creditType, occurredAt])
  @@index([workspaceId, creditType, occurredAt])
}

model BillingInvoice {
  id                 String              @id @default(cuid())
  organizationId     String
  subscriptionId     String?
  provider           String?
  providerInvoiceId  String?
  invoiceNumber      String?
  status             BillingInvoiceStatus @default(DRAFT)
  currency           String
  amountDueMinor     BigInt               @default(0)
  amountPaidMinor    BigInt               @default(0)
  amountRemainingMinor BigInt             @default(0)
  periodStart        DateTime?
  periodEnd          DateTime?
  dueAt              DateTime?
  issuedAt           DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     BillingPayment[]
  lines        BillingInvoiceLine[]

  @@unique([provider, providerInvoiceId])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, createdAt])
  @@index([subscriptionId])
}

model BillingInvoiceLine {
  id               String                 @id @default(cuid())
  invoiceId        String
  lineType         BillingInvoiceLineType
  description      String
  quantity         Int
  unitAmountMinor  BigInt
  totalAmountMinor BigInt
  entitlementKey   String?
  metadata         Json?
  createdAt        DateTime               @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, lineType])
}

model BillingPayment {
  id                  String               @id @default(cuid())
  organizationId      String
  invoiceId           String?
  provider            String?
  providerPaymentId   String?
  status              BillingPaymentStatus @default(PENDING)
  currency            String
  amountMinor         BigInt
  refundedAmountMinor BigInt               @default(0)
  failureCode         String?
  failureMessage      String?
  paidAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([organizationId, status, createdAt])
  @@index([invoiceId])
}

model BillingWebhookEvent {
  id              String             @id @default(cuid())
  organizationId  String?
  provider        String
  providerEventId String
  eventType       String
  payloadHash     String
  status          BillingWebhookStatus @default(RECEIVED)
  attemptCount    Int                @default(0)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  lastErrorCode   String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}


enum ComplianceRuleReviewState {
  UNREVIEWED
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum ComplianceRuleAssessmentState {
  APPLICABLE
  NOT_APPLICABLE
  UNKNOWN
}

model ComplianceRule {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  jurisdictionId String
  ruleKey        String
  currentVersion Int      @default(1)
  active         Boolean  @default(true)
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace             @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  jurisdiction Jurisdiction           @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  createdBy     User                  @relation("ComplianceRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions     ComplianceRuleVersion[]
  activities   ComplianceRuleActivity[]

  @@unique([organizationId, workspaceId, ruleKey])
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, jurisdictionId])
  @@index([workspaceId, jurisdictionId, active])
}

model ComplianceRuleVersion {
  id                  String                    @id @default(cuid())
  ruleId              String
  workspaceId         String
  version             Int
  jurisdictionId      String
  title               String
  description         String?
  obligationType      String
  sourceAuthority     String
  sourceUrl           String
  sourceRetrievedAt   DateTime?
  publicationDate     DateTime?
  effectiveFrom       DateTime
  effectiveThrough    DateTime?
  evidenceClass       EvidenceClass
  applicability       Json
  relativeDueDays     Int?
  requiresEvidence    Boolean                   @default(false)
  professionalReviewRequired Boolean             @default(true)
  reviewState         ComplianceRuleReviewState  @default(UNREVIEWED)
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?
  supersededByVersion Int?
  createdByUserId     String
  createdAt           DateTime                  @default(now())

  rule ComplianceRule @relation(fields: [ruleId, workspaceId, jurisdictionId], references: [id, workspaceId, jurisdictionId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User @relation("ComplianceRuleVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ComplianceRuleVersionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  deadlineSnapshots ComplianceDeadlineSnapshot[]
  obligations ComplianceObligation[]
  activities ComplianceRuleActivity[]

  @@unique([ruleId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId, jurisdictionId, reviewState])
  @@index([sourceRetrievedAt, effectiveThrough])
}

model ComplianceRuleActivity {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  ruleId         String
  ruleVersionId  String?
  actorUserId    String
  action         String
  note           String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  rule         ComplianceRule @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  ruleVersion  ComplianceRuleVersion? @relation(fields: [ruleVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  actor        User @relation("ComplianceRuleActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, occurredAt])
  @@index([ruleId, occurredAt])
  @@index([ruleVersionId, occurredAt])
}

model ComplianceDeadlineSnapshot {
  id                       String   @id @default(cuid())
  obligationId             String
  workspaceId              String
  sequence                 Int
  previousDueAt             DateTime?
  dueAt                     DateTime?
  reason                    String
  sourceRuleVersionId       String?
  assessmentState           ComplianceRuleAssessmentState @default(UNKNOWN)
  assessmentFacts           Json
  actorUserId               String
  createdAt                 DateTime @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRuleVersion ComplianceRuleVersion? @relation(fields: [sourceRuleVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  actor User @relation("ComplianceDeadlineSnapshotActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([obligationId, sequence])
  @@index([workspaceId, createdAt])
  @@index([obligationId, createdAt])
}

model ComplianceStatusSnapshot {
  id                String           @id @default(cuid())
  obligationId      String
  workspaceId       String
  sequence          Int
  previousStatus    ComplianceStatus
  currentStatus     ComplianceStatus
  completedAtBefore DateTime?
  completedAtAfter  DateTime?
  reason            String?
  actorUserId       String
  occurredAt        DateTime         @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor      User                 @relation("ComplianceStatusSnapshotActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([obligationId, sequence])
  @@index([workspaceId, occurredAt])
  @@index([obligationId, occurredAt])
}

enum PartnershipInquiryType {
  PROFESSIONAL_SERVICES
  TECHNOLOGY_PROVIDER
  FINANCIAL_INSTITUTION
  INSTITUTIONAL_PARTNER
  STRATEGIC_SPONSOR_INVESTOR
  DISTRIBUTION_ECOSYSTEM
}

enum PartnershipInquiryStatus {
  NEW
  IN_REVIEW
  CLOSED
}

// Public submissions; intentionally not tenant-scoped. Readable only by platform superadmins.
model PartnershipInquiry {
  id                String                   @id @default(cuid())
  partnerType       PartnershipInquiryType
  contactName       String
  email             String
  organisationName  String
  websiteUrl        String?
  country           String?
  message           String
  consentAcceptedAt DateTime
  status            PartnershipInquiryStatus @default(NEW)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

enum CorporateGraphNodeType {
  COMPANY
  PERSON
  TRUST
  PARTNERSHIP
  BRANCH
  BANKING_RELATIONSHIP
  LICENSE
  TAX_REGISTRATION
  OTHER
}

enum CorporateGraphRelationType {
  OWNS
  CONTROLS
  SUBSIDIARY_OF
  BRANCH_OF
  BANKS_WITH
  LICENSED_BY
  TAX_REGISTERED_WITH
  RELATED_TO
}

enum CorporateGraphAuditAction {
  NODE_CREATED
  NODE_UPDATED
  NODE_ARCHIVED
  EDGE_CREATED
  EDGE_ARCHIVED
}

model CorporateGraphNode {
  id                 String                 @id @default(cuid())
  organizationId     String
  workspaceId        String
  clientId           String?
  name               String
  nodeType           CorporateGraphNodeType @default(COMPANY)
  jurisdictionCode   String?
  entityType         String?
  registrationNumber String?
  metadata           Json?
  createdByUserId    String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  archivedAt         DateTime?
  archivedByUserId   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  outgoing     CorporateGraphEdge[] @relation("CorporateGraphFrom")
  incoming     CorporateGraphEdge[] @relation("CorporateGraphTo")

  @@unique([id, organizationId, workspaceId])
  @@index([organizationId, workspaceId])
  @@index([clientId, workspaceId])
  @@index([jurisdictionCode, entityType])
  @@index([organizationId, workspaceId, archivedAt])
}

model CorporateGraphEdge {
  id               String                     @id @default(cuid())
  organizationId   String
  workspaceId      String
  fromNodeId       String
  toNodeId         String
  relation         CorporateGraphRelationType
  ownershipPercent Decimal?                   @db.Decimal(5, 2)
  notes            String?
  createdByUserId  String
  createdAt        DateTime                   @default(now())
  archivedAt       DateTime?
  archivedByUserId String?

  fromNode CorporateGraphNode @relation("CorporateGraphFrom", fields: [fromNodeId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Cascade)
  toNode   CorporateGraphNode @relation("CorporateGraphTo", fields: [toNodeId, organizationId, workspaceId], references: [id, organizationId, workspaceId], onDelete: Cascade)

  @@unique([organizationId, workspaceId, fromNodeId, toNodeId, relation])
  @@index([organizationId, workspaceId, fromNodeId])
  @@index([organizationId, workspaceId, toNodeId])
  @@index([organizationId, workspaceId, archivedAt])
}

model CorporateGraphAuditEvent {
  id             String                   @id @default(cuid())
  organizationId String
  workspaceId    String
  actorUserId    String
  action         CorporateGraphAuditAction
  subjectType    String
  subjectId      String
  details        Json?
  occurredAt     DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  actor        User         @relation("CorporateGraphAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
}

model Successor {
  id                            String                     @id @default(cuid())
  ownerId                       String
  successorEmail                String
  successorName                 String
  successorGithub               String?
  relationship                  String
  status                        SuccessorStatus            @default(PENDING)
  verificationLevel             SuccessorVerificationLevel @default(EMAIL_INVITE)
  autoActivateAfterDays         Int                        @default(60)
  permissions                   Json
  inviteTokenHash               String?                    @unique
  inviteExpiresAt               DateTime?
  acceptedAt                    DateTime?
  idVerifiedAt                  DateTime?
  mfaVerifiedAt                 DateTime?
  highPermissionVerificationNote String?
  lastOwnerActivityAt            DateTime                   @default(now())
  warningSentAt                 DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  owner User @relation("SuccessorOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  continuityCases BusinessContinuityCase[]

  @@index([ownerId, status])
  @@index([status, lastOwnerActivityAt])
}

model BusinessContinuityCase {
  id                  String               @id @default(cuid())
  successorId         String
  status              ContinuityCaseStatus @default(WARNING_SENT)
  inactivityStartedAt DateTime
  warningSentAt       DateTime?
  reviewRequiredAt    DateTime?
  activatedAt         DateTime?
  cancelledAt         DateTime?
  closedAt            DateTime?
  closureReason       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  successor Successor @relation(fields: [successorId], references: [id], onDelete: Restrict)
  transmissionPackage ContinuityTransmissionPackage?

  @@index([successorId, status])
  @@index([status, updatedAt])
}

model ContinuityAsset {
  id               String   @id @default(cuid())
  ownerId          String
  assetType        String
  label            String
  recoveryLocation String
  criticality      String   @default("HIGH")
  notes            String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  owner User @relation("ContinuityAssetOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, assetType])
}

model ContinuityRunbook {
  id         String   @id @default(cuid())
  ownerId    String
  title      String
  content    String
  version    Int      @default(1)
  reviewedAt DateTime?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  owner User @relation("ContinuityRunbookOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, updatedAt])
}

model ContinuityTransmissionPackage {
  id                  String   @id @default(cuid())
  caseId              String   @unique
  manifest            Json
  encryptedOwnerNote  String?
  encryptionKeyRef    String?
  encryptionAlgorithm String?
  generatedAt         DateTime @default(now())
  releasedAt          DateTime?

  continuityCase BusinessContinuityCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
}

model FirebaseStepUpChallenge {
  id            String   @id @default(cuid())
  userId        String
  firebaseUid   String
  handleHash    String   @unique
  operation     String
  sessionHash   String
  authTime      DateTime
  secondFactor  String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, operation, expiresAt])
  @@index([expiresAt, consumedAt])
}


model FirebaseIdentity {
  id             String   @id @default(cuid())
  userId         String   @unique
  projectId      String
  firebaseUid    String
  linkedAt       DateTime @default(now())
  linkedByUserId String
  auditEventId   String   @unique

  user          User               @relation("FirebaseIdentityUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedByUser  User               @relation("FirebaseIdentityLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  auditEvent    PlatformAuditEvent @relation("FirebaseIdentityAuditEvent", fields: [auditEventId], references: [id], onDelete: Restrict)

  @@unique([projectId, firebaseUid])
  @@index([linkedByUserId, linkedAt])
}
