generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  ADVISOR
  VIEWER
}

enum PlatformPermission {
  DASHBOARD_READ
  CLIENTS_READ
  PARTNERSHIP_INQUIRIES_READ
  ADMINS_READ
  AUDIT_READ
}


enum SuccessorStatus {
  PENDING
  ACCEPTED
  ACTIVE
  REVOKED
}

enum SuccessorVerificationLevel {
  EMAIL_INVITE
  ID_VERIFIED
}

enum ContinuityCaseStatus {
  WARNING_SENT
  REVIEW_REQUIRED
  ACTIVATED
  CANCELLED
  CLOSED
}


enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationAttemptStatus {
  ATTEMPTING
  ACCEPTED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

enum ClientPortalInteractionKind {
  MESSAGE
  COMPLETION_SUBMISSION
  ACKNOWLEDGMENT_REQUEST
  ACKNOWLEDGMENT
}

enum ClientPortalInteractionStatus {
  PENDING
  ACCEPTED
  CHANGES_REQUESTED
  ACKNOWLEDGED
}

enum BillingPlanTier {
  FREE
  FOUNDER
  PROFESSIONAL
  FIRM
  ENTERPRISE
}

enum BillingEntitlementKind {
  ACCESS
  LIMIT
  METERED
  CREDIT
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  ENDED
}

enum BillingInterval {
  MONTH
  YEAR
  CUSTOM
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingCreditEntryType {
  GRANT
  PURCHASE
  USAGE
  EXPIRY
  REFUND
  ADJUSTMENT
}

enum BillingCreditDirection {
  CREDIT
  DEBIT
}

enum BillingInvoiceLineType {
  SUBSCRIPTION
  USAGE
  CREDITS
  PROFESSIONAL_REVIEW
  OTHER
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum MarketEntryStatus {
  ASSESSING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum BusinessIntentProposalStatus {
  PROPOSED
  REVIEW_REQUESTED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BusinessIntentReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum AIExecutionAuthorizationStatus {
  AUTHORIZED
  CONSUMED
  REVOKED
  EXPIRED
}

enum AIExecutionOperationType {
  CORPORATE_GRAPH_MUTATION
  FILING_SUBMISSION
  PAYMENT
  PRIVILEGE_CHANGE
}

enum MarketEntryReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum EvidenceReviewStatus {
  PENDING
  VERIFIED
  CHANGES_REQUESTED
  REVOKED
}

enum DocumentStorageStatus {
  PENDING_SCAN
  AVAILABLE
  INFECTED
  DELETED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  LEGACY_UNVERIFIED
}

enum DocumentReviewStatus {
  UNREVIEWED
  IN_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum CrossBorderDossierStatus {
  PREPARING
  REVIEWED
  CHANGES_REQUESTED
  ARCHIVED
}

enum CrossBorderControlStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLETE
  NOT_APPLICABLE
}

enum EngagementStatus {
  DRAFT
  INTAKE
  ASSESSMENT
  PLANNING
  EXECUTION
  RECORDING
  VERIFICATION
  APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_EVIDENCE
  IN_REVIEW
  COMPLETE
  COMPLETED
  COMPLIANT
  OVERDUE
  BLOCKED
  WAIVED
  NOT_APPLICABLE
}

enum EvidenceClass {
  E0
  E1
  E2
  E3
  E4
  E0_UNKNOWN
  E1_USER_PROVIDED
  E2_SECONDARY
  E3_PRIMARY
  E4_CROSS_VERIFIED
}

enum ActivityType {
  CREATED
  UPDATED
  REVIEWED
  APPROVED
  COMPLETED
  COMMENTED
  STATUS_CHANGED
  DOCUMENT_ATTACHED
  NOTE
  STATUS_CHANGE
  DOCUMENT
  REPORT
  TASK
  APPROVAL
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum OperationalActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  RESOLVED
  CANCELLED
}

enum OperationalActionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum OperationalActionEventType {
  CREATED_FROM_SIGNAL
  ACTION_CREATED
  ACTION_ASSIGNED
  ACTION_STARTED
  ACTION_SUBMITTED_FOR_REVIEW
  ACTION_BLOCKED
  ACTION_RESOLVED
  ACTION_ESCALATED
  ACTION_CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  workspaces            Workspace[]
  clients               Client[]
  jurisdictions         Jurisdiction[]
  complianceObligations ComplianceObligation[]
  complianceRules             ComplianceRule[]
  complianceRuleActivities    ComplianceRuleActivity[]
  marketEntryPlans      MarketEntryPlan[]
  billingSubscriptions  BillingSubscription[]
  billingUsageEvents    BillingUsageEvent[]
  billingCreditEntries  BillingCreditEntry[]
  billingInvoices       BillingInvoice[]
  billingPayments      BillingPayment[]
  billingWebhookEvents BillingWebhookEvent[]
  clientPortalGrants   ClientPortalGrant[]
  clientPortalEvents   ClientPortalAuditEvent[]
  clientPortalInteractions ClientPortalInteraction[]
  corporateGraphNodes        CorporateGraphNode[]
  corporateGraphAuditEvents CorporateGraphAuditEvent[]
  aiExecutionAuthorizations AIExecutionAuthorization[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             Membership[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  activities              Activity[]               @relation("ActivityActor")
  notificationPreferences NotificationPreference[]
  clientPortalGrants     ClientPortalGrant[]      @relation("ClientPortalGrantUser")
  portalGrantsCreated    ClientPortalGrant[]      @relation("ClientPortalGrantCreatedBy")
  clientPortalEvents     ClientPortalAuditEvent[] @relation("PortalAuditActor")
  portalInteractionsAuthored ClientPortalInteraction[] @relation("PortalInteractionActor")
  portalInteractionsReviewed ClientPortalInteraction[] @relation("PortalInteractionReviewer")
  platformAdministrator     PlatformAdministrator?
  platformSuperAdmin        PlatformSuperAdmin?
  platformPermissionsGranted PlatformAdministratorPermission[] @relation("PlatformPermissionGrantor")
  platformAuditEvents       PlatformAuditEvent[] @relation("PlatformAuditActor")
  successorsOwned            Successor[] @relation("SuccessorOwner")
  continuityAssets           ContinuityAsset[] @relation("ContinuityAssetOwner")
  continuityRunbooks          ContinuityRunbook[] @relation("ContinuityRunbookOwner")
  businessIntentProposalsCreated BusinessIntentProposal[] @relation("BusinessIntentProposalCreator")
  businessIntentProposalsReviewed BusinessIntentProposal[] @relation("BusinessIntentProposalReviewer")
  businessIntentProposalReviews BusinessIntentProposalReview[] @relation("BusinessIntentProposalReviewActor")
  aiExecutionAuthorizationsCreated AIExecutionAuthorization[] @relation("AIExecutionAuthorizationActor")
  aiExecutionAuthorizationsConsumed AIExecutionAuthorization[] @relation("AIExecutionAuthorizationConsumer")
  complianceRulesCreated             ComplianceRule[]                  @relation("ComplianceRuleCreatedBy")
  complianceRuleVersionsCreated      ComplianceRuleVersion[]           @relation("ComplianceRuleVersionCreatedBy")
  complianceRulesReviewed             ComplianceRuleVersion[]           @relation("ComplianceRuleVersionReviewer")
  complianceDeadlineSnapshots         ComplianceDeadlineSnapshot[]      @relation("ComplianceDeadlineSnapshotActor")
  complianceStatusSnapshots            ComplianceStatusSnapshot[]        @relation("ComplianceStatusSnapshotActor")
  complianceRuleActivities            ComplianceRuleActivity[]          @relation("ComplianceRuleActivityActor")
  corporateGraphAuditEvents CorporateGraphAuditEvent[] @relation("CorporateGraphAuditActor")
  firebaseIdentity FirebaseIdentity? @relation("FirebaseIdentityUser")
  firebaseIdentitiesLinked FirebaseIdentity[] @relation("FirebaseIdentityLinker")
  firebaseStepUpChallenges FirebaseStepUpChallenge[]

}

model PlatformAdministrator {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user        User                             @relation(fields: [userId], references: [id], onDelete: Restrict)
  permissions PlatformAdministratorPermission[]

  @@index([createdAt])
}

model PlatformSuperAdmin {
  id         String   @id @default("singleton")
  userId     String   @unique
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PlatformAdministratorPermission {
  id                    String             @id @default(cuid())
  administratorId      String
  permission            PlatformPermission
  grantedByUserId       String
  createdAt             DateTime           @default(now())

  administrator PlatformAdministrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  grantedBy     User                  @relation("PlatformPermissionGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([administratorId, permission])
  @@index([grantedByUserId, createdAt])
}

model PlatformAuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  action      String
  subjectType String?
  subjectId   String?
  outcome     String
  reason      String?
  details     Json?
  occurredAt  DateTime @default(now())

  actor User? @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  firebaseIdentityLink FirebaseIdentity? @relation("FirebaseIdentityAuditEvent")

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
}

model Membership {
  id             String   @id @default(cuid())
  role           UserRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationPreferences    NotificationPreference[]
  notifications              ComplianceNotification[]
  clients                    Client[]
  engagements                Engagement[]
  jurisdictions              Jurisdiction[]
  complianceItems            ComplianceItem[]
  settings                   WorkspaceSettings?
  jurisdictionComparisons    JurisdictionComparison[]
  formationPlans             FormationPlan[]
  workingDecisions           WorkingJurisdictionDecision[]
  complianceObligations      ComplianceObligation[]
  complianceRules              ComplianceRule[]
  complianceRuleVersions       ComplianceRuleVersion[]
  complianceDeadlineSnapshots  ComplianceDeadlineSnapshot[]
  complianceStatusSnapshots    ComplianceStatusSnapshot[]
  complianceRuleActivities     ComplianceRuleActivity[]
  marketEntryPlans           MarketEntryPlan[]
  marketReadinessAssessments MarketReadinessAssessment[]
  documents                  Document[]
  documentAccessEvents       DocumentAccessEvent[]
  complianceEvidence         ComplianceEvidence[]
  reports                    Report[]
  activities                 Activity[]
  tasks                      Task[]
  crossBorderDossiers        CrossBorderDossier[]
  clientPortalGrants          ClientPortalGrant[]
  clientPortalEvents          ClientPortalAuditEvent[]
  clientPortalInteractions    ClientPortalInteraction[]
  billingUsageEvents         BillingUsageEvent[]
  billingCreditEntries       BillingCreditEntry[]
  businessIntentProposals    BusinessIntentProposal[]
  businessIntentEvidenceReferences BusinessIntentEvidenceReference[]
  aiExecutionAuthorizations AIExecutionAuthorization[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
  corporateGraphNodes        CorporateGraphNode[]
  corporateGraphAuditEvents CorporateGraphAuditEvent[]
}

model Client {
  id               String   @id @default(cuid())
  organizationId   String?
  workspaceId      String
  name             String?
  firstName        String?
  lastName         String?
  organizationName String?
  email            String?
  phone            String?
  country          String?
  proposedBusiness String?
  intakeData       Json?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile       BusinessProfile?
  formationPlans        FormationPlan[]
  complianceObligations ComplianceObligation[]
  engagements           Engagement[]
  documents             Document[]
  reports               Report[]
  businessIntentProposals BusinessIntentProposal[]
  businessIntentEvidenceReferences BusinessIntentEvidenceReference[]
  crossBorderDossiers   CrossBorderDossier[]
  portalAccessGrants    ClientPortalGrant[]
  portalEvents          ClientPortalAuditEvent[]
  portalInteractions    ClientPortalInteraction[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  corporateGraphNodes CorporateGraphNode[]
}

model BusinessProfile {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  businessName        String?
  businessType        String?
  businessObjective   String?
  businessModel       String?
  targetMarket        String?
  revenueModel        String?
  ownershipContext    String?
  fundingStage        String?
  expansionObjectives String?
  constraints         String?
  strategicNotes      String?
  operationalContext  String?
  data                Json?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formationPlans   FormationPlan[]
  marketEntryPlans MarketEntryPlan[]
}

model Engagement {
  id          String           @id @default(cuid())
  workspaceId String
  clientId    String
  service     String
  status      EngagementStatus @default(DRAFT)
  nextAction  String?
  ownerId     String?
  startedAt   DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks           Task[]
  reports         Report[]
  activities      Activity[]
  complianceItems ComplianceItem[]
  documents       Document[]
  roadmap         FormationRoadmap?

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
}

model Jurisdiction {
  id             String    @id @default(cuid())
  organizationId String?
  workspaceId    String?
  name           String
  country        String
  code           String?
  countryCode    String?
  description    String?
  profile        Json?
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                   Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace                      Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  evidence                       Evidence[]
  roadmap                        FormationRoadmap[]
  observations                   JurisdictionObservation[]
  workingDecisions               WorkingJurisdictionDecision[]
  formationPlans                 FormationPlan[]
  complianceObligations          ComplianceObligation[]
  complianceRules                ComplianceRule[]
  marketEntryPlans               MarketEntryPlan[]
  crossBorderDossiersOrigin      CrossBorderDossier[]          @relation("CrossBorderOrigin")
  crossBorderDossiersDestination CrossBorderDossier[]          @relation("CrossBorderDestination")

  @@index([workspaceId])
  @@index([country])
}

model FormationRoadmap {
  id             String   @id @default(cuid())
  engagementId   String?  @unique
  clientId       String?
  jurisdictionId String?
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  engagement   Engagement?     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  steps        FormationStep[]
}

model FormationStep {
  id          String    @id @default(cuid())
  roadmapId   String
  sequence    Int
  title       String
  description String?
  completed   Boolean   @default(false)
  dueAt       DateTime?

  roadmap FormationRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, sequence])
}

model ComplianceItem {
  id           String           @id @default(cuid())
  engagementId String?
  workspaceId  String
  clientId     String?
  title        String
  category     String?
  jurisdiction String?
  status       ComplianceStatus @default(NOT_STARTED)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@index([workspaceId])
  @@index([status])
  @@index([dueAt])
}

model Evidence {
  id               String        @id @default(cuid())
  title            String
  source           String?
  sourceType       String?
  publicationDate  DateTime?
  retrievedAt      DateTime?
  evidenceClass    EvidenceClass @default(E0_UNKNOWN)
  confidence       Int?
  reviewStatus     String?
  notes            String?
  jurisdictionId   String?
  complianceItemId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  jurisdiction   Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  complianceItem ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: SetNull)
  documents      Document[]
  businessIntentEvidenceReferences BusinessIntentEvidenceReference[]

  @@index([evidenceClass])
  @@index([jurisdictionId])
}

model Document {
  id                     String                @id @default(cuid())
  workspaceId            String
  clientId               String?
  engagementId           String?
  complianceObligationId String?
  evidenceId             String?
  rootDocumentId         String
  previousVersionId      String?
  version                Int                   @default(1)
  latestVersion          Int                   @default(1)
  name                   String
  description            String?
  documentType           String                @default("OTHER")
  mimeType               String
  storageKey             String                @unique
  sizeBytes              Int
  checksum               String
  status                 DocumentStorageStatus @default(PENDING_SCAN)
  scanStatus             DocumentScanStatus    @default(PENDING)
  reviewStatus           DocumentReviewStatus  @default(UNREVIEWED)
  uploadedByUserId       String
  reviewedByUserId       String?
  reviewedAt             DateTime?
  reviewNote             String?
  retainUntil            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  workspace                  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                     Client?                      @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  engagement                 Engagement?                  @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  complianceObligation       ComplianceObligation?        @relation(fields: [complianceObligationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  evidence                   Evidence?                    @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  rootDocument               Document                     @relation("DocumentVersions", fields: [rootDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  versions                   Document[]                   @relation("DocumentVersions")
  previousVersion            Document?                    @relation("DocumentPreviousVersion", fields: [previousVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  nextVersions               Document[]                   @relation("DocumentPreviousVersion")
  accessEvents               DocumentAccessEvent[]
  complianceEvidence         ComplianceEvidence[]
  businessIntentEvidenceReferences BusinessIntentEvidenceReference[]
  crossBorderControlEvidence CrossBorderControlEvidence[]

  @@unique([rootDocumentId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, createdAt])
  @@index([clientId])
  @@index([engagementId])
  @@index([complianceObligationId])
  @@index([retainUntil, deletedAt])
}

model DocumentAccessEvent {
  id          String   @id @default(cuid())
  documentId  String
  workspaceId String
  actorUserId String?
  action      String
  metadata    Json?
  occurredAt  DateTime @default(now())

  document  Document  @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([documentId, occurredAt])
}

model Report {
  id           String   @id @default(cuid())
  workspaceId  String
  clientId     String?
  engagementId String?
  title        String
  format       String?
  status       String?
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
  @@index([engagementId])
}

model Activity {
  id           String       @id @default(cuid())
  engagementId String?
  workspaceId  String
  actorId      String?
  type         ActivityType @default(SYSTEM)
  title        String
  summary      String?
  description  String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([engagementId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  engagementId String?
  assigneeId   String?
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  completedAt  DateTime?
  portalVisible Boolean  @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([assigneeId])
  @@index([dueAt])
}

model WorkspaceSettings {
  id                          String   @id @default(cuid())
  workspaceId                 String   @unique
  timezone                    String   @default("UTC")
  defaultLandingPage          String   @default("/command-center")
  complianceReminderDays      Int      @default(30)
  notificationsEnabled        Boolean  @default(true)
  complianceDueNotifications  Boolean  @default(true)
  evidenceReviewNotifications Boolean  @default(true)
  documentRetentionDays       Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model JurisdictionObservation {
  id             String       @id @default(cuid())
  jurisdictionId String
  criterionKey   String
  value          Float
  evidenceIds    String[]
  assumptions    String[]
  reviewRequired Boolean      @default(false)
  createdAt      DateTime     @default(now())
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([jurisdictionId, criterionKey])
}

model JurisdictionComparison {
  id                  String   @id @default(cuid())
  workspaceId         String
  businessProfileId   String?
  methodologyVersion  String
  criteriaJson        String
  jurisdictionIdsJson String
  resultsJson         String
  createdAt           DateTime @default(now())

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workingDecisions WorkingJurisdictionDecision[]
  marketEntryPlans MarketEntryPlan[]

  @@index([workspaceId, createdAt])
  @@index([businessProfileId, createdAt])
}

model WorkingJurisdictionDecision {
  id                          String   @id @default(cuid())
  workspaceId                 String
  businessProfileId           String
  comparisonSnapshotId        String
  jurisdictionId              String
  rationale                   String?
  decidedByUserId             String
  decidedAt                   DateTime @default(now())
  professionalReviewRequired  Boolean  @default(true)
  professionalReviewCompleted Boolean  @default(false)

  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
