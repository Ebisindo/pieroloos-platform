generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  ADVISOR
  VIEWER
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum NotificationAttemptStatus {
  ATTEMPTING
  ACCEPTED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

enum ClientPortalInteractionKind {
  MESSAGE
  COMPLETION_SUBMISSION
  ACKNOWLEDGMENT_REQUEST
  ACKNOWLEDGMENT
}

enum ClientPortalInteractionStatus {
  PENDING
  ACCEPTED
  CHANGES_REQUESTED
  ACKNOWLEDGED
}

enum BillingPlanTier {
  FREE
  FOUNDER
  PROFESSIONAL
  FIRM
  ENTERPRISE
}

enum BillingEntitlementKind {
  ACCESS
  LIMIT
  METERED
  CREDIT
}

enum BillingSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  ENDED
}

enum BillingInterval {
  MONTH
  YEAR
  CUSTOM
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingCreditEntryType {
  GRANT
  PURCHASE
  USAGE
  EXPIRY
  REFUND
  ADJUSTMENT
}

enum BillingCreditDirection {
  CREDIT
  DEBIT
}

enum BillingInvoiceLineType {
  SUBSCRIPTION
  USAGE
  CREDITS
  PROFESSIONAL_REVIEW
  OTHER
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum MarketEntryStatus {
  ASSESSING
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum MarketEntryReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum EvidenceReviewStatus {
  PENDING
  VERIFIED
  CHANGES_REQUESTED
}

enum DocumentStorageStatus {
  PENDING_SCAN
  AVAILABLE
  INFECTED
  DELETED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  LEGACY_UNVERIFIED
}

enum DocumentReviewStatus {
  UNREVIEWED
  IN_REVIEW
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum CrossBorderDossierStatus {
  PREPARING
  REVIEWED
  CHANGES_REQUESTED
  ARCHIVED
}

enum CrossBorderControlStatus {
  NOT_ASSESSED
  IN_PROGRESS
  COMPLETE
  NOT_APPLICABLE
}

enum EngagementStatus {
  DRAFT
  INTAKE
  ASSESSMENT
  PLANNING
  EXECUTION
  RECORDING
  VERIFICATION
  APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_EVIDENCE
  IN_REVIEW
  COMPLETE
  COMPLETED
  COMPLIANT
  OVERDUE
  BLOCKED
  WAIVED
  NOT_APPLICABLE
}

enum EvidenceClass {
  E0
  E1
  E2
  E3
  E4
  E0_UNKNOWN
  E1_USER_PROVIDED
  E2_SECONDARY
  E3_PRIMARY
  E4_CROSS_VERIFIED
}

enum ActivityType {
  CREATED
  UPDATED
  REVIEWED
  APPROVED
  COMPLETED
  COMMENTED
  STATUS_CHANGED
  DOCUMENT_ATTACHED
  NOTE
  STATUS_CHANGE
  DOCUMENT
  REPORT
  TASK
  APPROVAL
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum OperationalActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  RESOLVED
  CANCELLED
}

enum OperationalActionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum OperationalActionEventType {
  CREATED_FROM_SIGNAL
  ACTION_CREATED
  ACTION_ASSIGNED
  ACTION_STARTED
  ACTION_SUBMITTED_FOR_REVIEW
  ACTION_BLOCKED
  ACTION_RESOLVED
  ACTION_ESCALATED
  ACTION_CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  workspaces            Workspace[]
  clients               Client[]
  jurisdictions         Jurisdiction[]
  complianceObligations ComplianceObligation[]
  marketEntryPlans      MarketEntryPlan[]
  billingSubscriptions  BillingSubscription[]
  billingUsageEvents    BillingUsageEvent[]
  billingCreditEntries  BillingCreditEntry[]
  billingInvoices       BillingInvoice[]
  billingPayments      BillingPayment[]
  billingWebhookEvents BillingWebhookEvent[]
  clientPortalGrants   ClientPortalGrant[]
  clientPortalEvents   ClientPortalAuditEvent[]
  clientPortalInteractions ClientPortalInteraction[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             Membership[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  activities              Activity[]               @relation("ActivityActor")
  notificationPreferences NotificationPreference[]
  clientPortalGrants     ClientPortalGrant[]      @relation("ClientPortalGrantUser")
  portalGrantsCreated    ClientPortalGrant[]      @relation("ClientPortalGrantCreatedBy")
  clientPortalEvents     ClientPortalAuditEvent[] @relation("PortalAuditActor")
  portalInteractionsAuthored ClientPortalInteraction[] @relation("PortalInteractionActor")
  portalInteractionsReviewed ClientPortalInteraction[] @relation("PortalInteractionReviewer")
}

model Membership {
  id             String   @id @default(cuid())
  role           UserRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationPreferences    NotificationPreference[]
  notifications              ComplianceNotification[]
  clients                    Client[]
  engagements                Engagement[]
  jurisdictions              Jurisdiction[]
  complianceItems            ComplianceItem[]
  settings                   WorkspaceSettings?
  jurisdictionComparisons    JurisdictionComparison[]
  formationPlans             FormationPlan[]
  workingDecisions           WorkingJurisdictionDecision[]
  complianceObligations      ComplianceObligation[]
  marketEntryPlans           MarketEntryPlan[]
  marketReadinessAssessments MarketReadinessAssessment[]
  documents                  Document[]
  documentAccessEvents       DocumentAccessEvent[]
  complianceEvidence         ComplianceEvidence[]
  reports                    Report[]
  activities                 Activity[]
  tasks                      Task[]
  crossBorderDossiers        CrossBorderDossier[]
  clientPortalGrants          ClientPortalGrant[]
  clientPortalEvents          ClientPortalAuditEvent[]
  clientPortalInteractions    ClientPortalInteraction[]
  billingUsageEvents         BillingUsageEvent[]
  billingCreditEntries       BillingCreditEntry[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId])
}

model Client {
  id               String   @id @default(cuid())
  organizationId   String?
  workspaceId      String
  name             String?
  firstName        String?
  lastName         String?
  organizationName String?
  email            String?
  phone            String?
  country          String?
  proposedBusiness String?
  intakeData       Json?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile       BusinessProfile?
  formationPlans        FormationPlan[]
  complianceObligations ComplianceObligation[]
  engagements           Engagement[]
  documents             Document[]
  reports               Report[]
  crossBorderDossiers   CrossBorderDossier[]
  portalAccessGrants    ClientPortalGrant[]
  portalEvents          ClientPortalAuditEvent[]
  portalInteractions    ClientPortalInteraction[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
}

model BusinessProfile {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  businessName        String?
  businessType        String?
  businessObjective   String?
  businessModel       String?
  targetMarket        String?
  revenueModel        String?
  ownershipContext    String?
  fundingStage        String?
  expansionObjectives String?
  constraints         String?
  strategicNotes      String?
  operationalContext  String?
  data                Json?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formationPlans   FormationPlan[]
  marketEntryPlans MarketEntryPlan[]
}

model Engagement {
  id          String           @id @default(cuid())
  workspaceId String
  clientId    String
  service     String
  status      EngagementStatus @default(DRAFT)
  nextAction  String?
  ownerId     String?
  startedAt   DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks           Task[]
  reports         Report[]
  activities      Activity[]
  complianceItems ComplianceItem[]
  documents       Document[]
  roadmap         FormationRoadmap?

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
}

model Jurisdiction {
  id             String    @id @default(cuid())
  organizationId String?
  workspaceId    String?
  name           String
  country        String
  code           String?
  countryCode    String?
  description    String?
  profile        Json?
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                   Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace                      Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  evidence                       Evidence[]
  roadmap                        FormationRoadmap[]
  observations                   JurisdictionObservation[]
  workingDecisions               WorkingJurisdictionDecision[]
  formationPlans                 FormationPlan[]
  complianceObligations          ComplianceObligation[]
  marketEntryPlans               MarketEntryPlan[]
  crossBorderDossiersOrigin      CrossBorderDossier[]          @relation("CrossBorderOrigin")
  crossBorderDossiersDestination CrossBorderDossier[]          @relation("CrossBorderDestination")

  @@index([workspaceId])
  @@index([country])
}

model FormationRoadmap {
  id             String   @id @default(cuid())
  engagementId   String?  @unique
  clientId       String?
  jurisdictionId String?
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  engagement   Engagement?     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  steps        FormationStep[]
}

model FormationStep {
  id          String    @id @default(cuid())
  roadmapId   String
  sequence    Int
  title       String
  description String?
  completed   Boolean   @default(false)
  dueAt       DateTime?

  roadmap FormationRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, sequence])
}

model ComplianceItem {
  id           String           @id @default(cuid())
  engagementId String?
  workspaceId  String
  clientId     String?
  title        String
  category     String?
  jurisdiction String?
  status       ComplianceStatus @default(NOT_STARTED)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@index([workspaceId])
  @@index([status])
  @@index([dueAt])
}

model Evidence {
  id               String        @id @default(cuid())
  title            String
  source           String?
  sourceType       String?
  publicationDate  DateTime?
  retrievedAt      DateTime?
  evidenceClass    EvidenceClass @default(E0_UNKNOWN)
  confidence       Int?
  reviewStatus     String?
  notes            String?
  jurisdictionId   String?
  complianceItemId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  jurisdiction   Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  complianceItem ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: SetNull)
  documents      Document[]

  @@index([evidenceClass])
  @@index([jurisdictionId])
}

model Document {
  id                     String                @id @default(cuid())
  workspaceId            String
  clientId               String?
  engagementId           String?
  complianceObligationId String?
  evidenceId             String?
  rootDocumentId         String
  previousVersionId      String?
  version                Int                   @default(1)
  latestVersion          Int                   @default(1)
  name                   String
  description            String?
  documentType           String                @default("OTHER")
  mimeType               String
  storageKey             String                @unique
  sizeBytes              Int
  checksum               String
  status                 DocumentStorageStatus @default(PENDING_SCAN)
  scanStatus             DocumentScanStatus    @default(PENDING)
  reviewStatus           DocumentReviewStatus  @default(UNREVIEWED)
  uploadedByUserId       String
  reviewedByUserId       String?
  reviewedAt             DateTime?
  reviewNote             String?
  retainUntil            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  workspace                  Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                     Client?                      @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  engagement                 Engagement?                  @relation(fields: [engagementId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  complianceObligation       ComplianceObligation?        @relation(fields: [complianceObligationId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  evidence                   Evidence?                    @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  rootDocument               Document                     @relation("DocumentVersions", fields: [rootDocumentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  versions                   Document[]                   @relation("DocumentVersions")
  previousVersion            Document?                    @relation("DocumentPreviousVersion", fields: [previousVersionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  nextVersions               Document[]                   @relation("DocumentPreviousVersion")
  accessEvents               DocumentAccessEvent[]
  complianceEvidence         ComplianceEvidence[]
  crossBorderControlEvidence CrossBorderControlEvidence[]

  @@unique([rootDocumentId, version])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, createdAt])
  @@index([clientId])
  @@index([engagementId])
  @@index([complianceObligationId])
  @@index([retainUntil, deletedAt])
}

model DocumentAccessEvent {
  id          String   @id @default(cuid())
  documentId  String
  workspaceId String
  actorUserId String?
  action      String
  metadata    Json?
  occurredAt  DateTime @default(now())

  document  Document  @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([documentId, occurredAt])
}

model Report {
  id           String   @id @default(cuid())
  workspaceId  String
  clientId     String?
  engagementId String?
  title        String
  format       String?
  status       String?
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
  @@index([engagementId])
}

model Activity {
  id           String       @id @default(cuid())
  engagementId String?
  workspaceId  String
  actorId      String?
  type         ActivityType @default(SYSTEM)
  title        String
  summary      String?
  description  String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([engagementId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  engagementId String?
  assigneeId   String?
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  completedAt  DateTime?
  portalVisible Boolean  @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([assigneeId])
  @@index([dueAt])
}

model WorkspaceSettings {
  id                          String   @id @default(cuid())
  workspaceId                 String   @unique
  timezone                    String   @default("UTC")
  defaultLandingPage          String   @default("/command-center")
  complianceReminderDays      Int      @default(30)
  notificationsEnabled        Boolean  @default(true)
  complianceDueNotifications  Boolean  @default(true)
  evidenceReviewNotifications Boolean  @default(true)
  documentRetentionDays       Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model JurisdictionObservation {
  id             String       @id @default(cuid())
  jurisdictionId String
  criterionKey   String
  value          Float
  evidenceIds    String[]
  assumptions    String[]
  reviewRequired Boolean      @default(false)
  createdAt      DateTime     @default(now())
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([jurisdictionId, criterionKey])
}

model JurisdictionComparison {
  id                  String   @id @default(cuid())
  workspaceId         String
  businessProfileId   String?
  methodologyVersion  String
  criteriaJson        String
  jurisdictionIdsJson String
  resultsJson         String
  createdAt           DateTime @default(now())

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workingDecisions WorkingJurisdictionDecision[]
  marketEntryPlans MarketEntryPlan[]

  @@index([workspaceId, createdAt])
  @@index([businessProfileId, createdAt])
}

model WorkingJurisdictionDecision {
  id                          String   @id @default(cuid())
  workspaceId                 String
  businessProfileId           String
  comparisonSnapshotId        String
  jurisdictionId              String
  rationale                   String?
  decidedByUserId             String
  decidedAt                   DateTime @default(now())
  professionalReviewRequired  Boolean  @default(true)
  professionalReviewCompleted Boolean  @default(false)

  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comparisonSnapshot JurisdictionComparison @relation(fields: [comparisonSnapshotId], references: [id], onDelete: Cascade)
  jurisdiction       Jurisdiction           @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  formationPlans     FormationPlan[]
  marketEntryPlans   MarketEntryPlan[]

  @@index([workspaceId, businessProfileId])
  @@index([jurisdictionId])
}

model FormationPlan {
  id                            String   @id @default(cuid())
  workspaceId                   String
  clientId                      String
  businessProfileId             String
  comparisonSnapshotId          String
  workingJurisdictionDecisionId String
  jurisdictionId                String
  jurisdictionName              String
  methodologyVersion            String
  status                        String   @default("DRAFT")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace                   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                      Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessProfile             BusinessProfile             @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  workingJurisdictionDecision WorkingJurisdictionDecision @relation(fields: [workingJurisdictionDecisionId], references: [id])
  jurisdiction                Jurisdiction                @relation(fields: [jurisdictionId], references: [id])
  stages                      FormationStage[]
  complianceObligations       ComplianceObligation[]
  marketEntryPlans            MarketEntryPlan[]

  @@index([workspaceId, createdAt])
  @@index([clientId])
  @@index([businessProfileId])
  @@index([jurisdictionId])
}

model FormationStage {
  id              String   @id @default(cuid())
  formationPlanId String
  key             String
  title           String
  description     String
  order           Int
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  formationPlan FormationPlan   @relation(fields: [formationPlanId], references: [id], onDelete: Cascade)
  tasks         FormationTask[]

  @@unique([formationPlanId, key])
  @@index([formationPlanId, order])
}

model FormationTask {
  id                         String    @id @default(cuid())
  formationStageId           String
  key                        String
  title                      String
  description                String
  order                      Int
  status                     String    @default("PENDING")
  dependsOnTaskKeys          String[]
  requiresProfessionalReview Boolean   @default(false)
  blockingReason             String?
  completionNote             String?
  completedAt                DateTime?
  portalVisible              Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  formationStage       FormationStage                 @relation(fields: [formationStageId], references: [id], onDelete: Cascade)
  evidenceRequirements FormationEvidenceRequirement[]
  reviews              FormationReview[]

  @@unique([formationStageId, key])
  @@index([formationStageId, order])
}

model FormationEvidenceRequirement {
  id              String    @id @default(cuid())
  formationTaskId String
  key             String
  label           String
  required        Boolean   @default(true)
  satisfied       Boolean   @default(false)
  evidenceId      String?
  satisfiedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  formationTask FormationTask @relation(fields: [formationTaskId], references: [id], onDelete: Cascade)

  @@unique([formationTaskId, key])
}

model FormationReview {
  id              String   @id @default(cuid())
  formationTaskId String
  reviewerUserId  String
  outcome         String
  note            String?
  reviewedAt      DateTime @default(now())

  formationTask FormationTask @relation(fields: [formationTaskId], references: [id], onDelete: Cascade)

  @@index([formationTaskId, reviewedAt])
}

model ComplianceObligation {
  id                          String           @id @default(cuid())
  organizationId              String
  workspaceId                 String
  clientId                    String
  businessProfileId           String?
  formationPlanId             String?
  jurisdictionId              String?
  sourceRuleId                String?
  title                       String
  description                 String?
  type                        String
  status                      ComplianceStatus @default(NOT_STARTED)
  dueAt                       DateTime?
  completedAt                 DateTime?
  ownerUserId                 String?
  professionalReviewRequired  Boolean          @default(false)
  professionalReviewCompleted Boolean          @default(false)
  escalationLevel             Int              @default(0)
  requiresEvidence            Boolean          @default(false)
  portalVisible               Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formationPlan FormationPlan?       @relation(fields: [formationPlanId], references: [id], onDelete: SetNull)
  jurisdiction  Jurisdiction?        @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  activities    ComplianceActivity[]
  reminders     ComplianceReminder[]
  evidence      ComplianceEvidence[]
  documents     Document[]

  @@unique([id, workspaceId])
  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([clientId])
}

model MarketEntryPlan {
  id                        String                  @id @default(cuid())
  workspaceId               String
  businessProfileId         String
  comparisonSnapshotId      String
  targetJurisdictionId      String
  formationPlanId           String?
  rationale                 String
  status                    MarketEntryStatus       @default(ASSESSING)
  reviewStatus              MarketEntryReviewStatus @default(PENDING)
  reviewNote                String?
  reviewedByUserId          String?
  reviewedAt                DateTime?
  reviewedAssessmentVersion Int?
  createdByUserId           String
  version                   Int                     @default(1)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  workspace                     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile               BusinessProfile              @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  comparisonSnapshot            JurisdictionComparison       @relation(fields: [comparisonSnapshotId], references: [id], onDelete: Restrict)
  targetJurisdiction            Jurisdiction                 @relation(fields: [targetJurisdictionId], references: [id], onDelete: Restrict)
  formationPlan                 FormationPlan?               @relation(fields: [formationPlanId], references: [id], onDelete: SetNull)
  auditEvents                   MarketEntryAuditEvent[]
  readinessAssessments          MarketReadinessAssessment[]
  crossBorderDossiers           CrossBorderDossier[]
  organization                  Organization?                @relation(fields: [organizationId], references: [id])
  organizationId                String?
  workingJurisdictionDecision   WorkingJurisdictionDecision? @relation(fields: [workingJurisdictionDecisionId], references: [id])
  workingJurisdictionDecisionId String?

  @@index([workspaceId, status, updatedAt])
  @@index([businessProfileId, updatedAt])
  @@index([targetJurisdictionId, status])
}

model MarketEntryAuditEvent {
  id                String   @id @default(cuid())
  marketEntryPlanId String
  workspaceId       String
  actorUserId       String
  eventType         String
  details           Json?
  occurredAt        DateTime @default(now())

  marketEntryPlan MarketEntryPlan @relation(fields: [marketEntryPlanId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([marketEntryPlanId, occurredAt])
}

model MarketReadinessAssessment {
  id                String   @id @default(cuid())
  marketEntryPlanId String
  workspaceId       String
  assessedByUserId  String
  planVersion       Int
  status            String
  resultJson        Json
  assessedAt        DateTime @default(now())

  marketEntryPlan MarketEntryPlan @relation(fields: [marketEntryPlanId], references: [id], onDelete: Restrict)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, assessedAt])
  @@index([marketEntryPlanId, assessedAt])
}

model ComplianceActivity {
  id           String   @id @default(cuid())
  obligationId String
  action       String
  actorUserId  String?
  note         String?
  metadata     Json?
  createdAt    DateTime @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId, createdAt])
}

model ComplianceReminder {
  id           String    @id @default(cuid())
  obligationId String
  scheduledFor DateTime
  channel      String
  message      String
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, sentAt])
}

model ComplianceEvidence {
  id               String               @id @default(cuid())
  workspaceId      String
  obligationId     String
  documentId       String
  evidenceClass    String
  note             String?
  sourceReference  String?
  validThrough     DateTime?
  reviewStatus     EvidenceReviewStatus @default(PENDING)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  document   Document             @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([obligationId, reviewStatus, validThrough])
  @@index([workspaceId, createdAt])
}

model CrossBorderDossier {
  id                        String                   @id @default(cuid())
  workspaceId               String
  clientId                  String
  marketEntryPlanId         String?
  originJurisdictionId      String
  destinationJurisdictionId String
  counterpartyName          String
  counterpartyCountry       String?
  activityDescription       String
  currencyCode              String?
  estimatedValue            Decimal?                 @db.Decimal(18, 2)
  status                    CrossBorderDossierStatus @default(PREPARING)
  version                   Int                      @default(1)
  createdByUserId           String
  reviewedByUserId          String?
  reviewNote                String?
  reviewedAt                DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  workspace               Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                  Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  marketEntryPlan         MarketEntryPlan?               @relation(fields: [marketEntryPlanId], references: [id], onDelete: SetNull)
  originJurisdiction      Jurisdiction                   @relation("CrossBorderOrigin", fields: [originJurisdictionId], references: [id], onDelete: Restrict)
  destinationJurisdiction Jurisdiction                   @relation("CrossBorderDestination", fields: [destinationJurisdictionId], references: [id], onDelete: Restrict)
  controls                CrossBorderDossierControl[]
  auditEvents             CrossBorderDossierAuditEvent[]

  @@index([workspaceId, status, updatedAt])
  @@index([clientId, createdAt])
  @@index([originJurisdictionId, destinationJurisdictionId])
}

model CrossBorderDossierControl {
  id               String                   @id @default(cuid())
  dossierId        String
  category         String
  title            String
  description      String?
  status           CrossBorderControlStatus @default(NOT_ASSESSED)
  requiresEvidence Boolean                  @default(false)
  createdByUserId  String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  dossier  CrossBorderDossier           @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  evidence CrossBorderControlEvidence[]

  @@index([dossierId, status])
}

model CrossBorderControlEvidence {
  id             String   @id @default(cuid())
  controlId      String
  documentId     String
  linkedByUserId String
  linkedAt       DateTime @default(now())

  control  CrossBorderDossierControl @relation(fields: [controlId], references: [id], onDelete: Cascade)
  document Document                  @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([controlId, documentId])
  @@index([documentId])
}

model CrossBorderDossierAuditEvent {
  id          String   @id @default(cuid())
  dossierId   String
  workspaceId String
  actorUserId String
  eventType   String
  details     Json?
  occurredAt  DateTime @default(now())

  dossier CrossBorderDossier @relation(fields: [dossierId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([dossierId, occurredAt])
}

model OperationalAction {
  id                     String                        @id @default(cuid())
  organizationId         String
  workspaceId            String
  title                  String
  description            String?
  sourceSignalId         String?
  clientId               String?
  engagementId           String?
  documentId             String?
  complianceObligationId String?
  assigneeUserId         String?
  createdByUserId        String
  priority               OperationalActionPriority     @default(NORMAL)
  status                 OperationalActionStatus       @default(OPEN)
  dueAt                  DateTime?
  escalationLevel        Int                           @default(0)
  escalationAt           DateTime?
  resolvedAt             DateTime?
  resolutionNote         String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  auditEvents            OperationalActionAuditEvent[]

  @@unique([organizationId, workspaceId, sourceSignalId])
  @@index([organizationId, workspaceId, status])
  @@index([organizationId, workspaceId, dueAt])
  @@index([assigneeUserId, status, dueAt])
  @@index([sourceSignalId])
  @@index([complianceObligationId, status])
}

model OperationalActionAuditEvent {
  id             String                     @id @default(cuid())
  organizationId String
  workspaceId    String
  actionId       String
  actorUserId    String
  eventType      OperationalActionEventType
  details        Json?
  occurredAt     DateTime                   @default(now())

  action OperationalAction @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, occurredAt])
  @@index([actionId, occurredAt])
}

model ComplianceNotification {
  id                String              @id @default(cuid())
  organizationId    String
  workspaceId       String
  obligationId      String?
  actionId          String?
  recipientUserId   String?
  channel           NotificationChannel
  subject           String
  body              String
  scheduledFor      DateTime
  status            NotificationStatus  @default(QUEUED)
  sentAt            DateTime?
  failedAt          DateTime?
  failureReason     String?
  dedupeKey         String
  attemptCount      Int                 @default(0)
  maxAttempts       Int                 @default(5)
  nextAttemptAt     DateTime            @default(now())
  lastAttemptAt     DateTime?
  lockedAt          DateTime?
  lockedBy          String?
  providerMessageId String?
  deliveryReceipt   String?
  templateKey       String              @default("legacy-notification")
  templateVersion   Int                 @default(1)
  deadLetteredAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  deliveryAttempts NotificationDeliveryAttempt[]
  workspace        Workspace                     @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, dedupeKey])
  @@index([organizationId, workspaceId, scheduledFor])
  @@index([organizationId, workspaceId, status])
  @@index([status, scheduledFor, nextAttemptAt, lockedAt])
}

model NotificationPreference {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String
  inAppEnabled    Boolean  @default(true)
  emailEnabled    Boolean  @default(false)
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model NotificationDeliveryAttempt {
  id                String                    @id @default(cuid())
  notificationId    String
  attemptNumber     Int
  status            NotificationAttemptStatus
  startedAt         DateTime                  @default(now())
  completedAt       DateTime?
  providerMessageId String?
  failureCode       String?
  failureMessage    String?

  notification ComplianceNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, attemptNumber])
  @@index([status, startedAt])
}

model ClientPortalGrant {
  id                 String   @id @default(cuid())
  organizationId     String
  workspaceId        String
  clientId           String
  userId             String
  grantedByUserId    String
  canViewStatus      Boolean  @default(true)
  canViewTasks       Boolean  @default(true)
  canUploadEvidence  Boolean  @default(true)
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user         User         @relation("ClientPortalGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("ClientPortalGrantCreatedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  events       ClientPortalAuditEvent[]
  interactions ClientPortalInteraction[]

  @@unique([clientId, userId])
  @@index([userId, revokedAt, expiresAt])
  @@index([organizationId, workspaceId, clientId, revokedAt])
}

model ClientPortalAuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  clientId       String
  grantId        String?
  actorUserId    String
  action         String
  resourceId     String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  grant        ClientPortalGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  actor        User               @relation("PortalAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, workspaceId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model ClientPortalInteraction {
  id                    String                         @id @default(cuid())
  organizationId        String
  workspaceId           String
  clientId              String
  grantId               String?
  actorUserId           String
  kind                  ClientPortalInteractionKind
  status                ClientPortalInteractionStatus?
  resourceType          String?
  resourceId            String?
  parentInteractionId   String?
  body                  String
  contentHash           String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime                       @default(now())

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace         Workspace                @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  client            Client                   @relation(fields: [clientId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  grant             ClientPortalGrant?       @relation(fields: [grantId], references: [id], onDelete: SetNull)
  actor             User                     @relation("PortalInteractionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reviewer          User?                    @relation("PortalInteractionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  parentInteraction ClientPortalInteraction? @relation("PortalInteractionThread", fields: [parentInteractionId], references: [id], onDelete: Restrict)
  childInteractions ClientPortalInteraction[] @relation("PortalInteractionThread")

  @@index([organizationId, workspaceId, clientId, createdAt])
  @@index([clientId, resourceType, resourceId, createdAt])
  @@index([parentInteractionId, createdAt])
  @@index([kind, status, createdAt])
}

model OperationalEscalationEvent {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  actionId       String
  fromLevel      Int
  toLevel        Int
  reason         String
  occurredAt     DateTime @default(now())

  @@unique([actionId, toLevel])
  @@index([organizationId, workspaceId, occurredAt])
  @@index([actionId, occurredAt])
}

model BillingPlan {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  tier        BillingPlanTier
  version     Int             @default(1)
  active      Boolean         @default(true)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  entitlements BillingPlanEntitlement[]
  subscriptions BillingSubscription[]

  @@index([tier, active])
}

model BillingPlanEntitlement {
  id          String                 @id @default(cuid())
  planId      String
  key         String
  kind        BillingEntitlementKind
  enabled     Boolean                @default(true)
  limit       Int?
  unit        String?
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key, enabled])
}

model BillingSubscription {
  id                    String                    @id @default(cuid())
  organizationId        String
  planId                String
  status                BillingSubscriptionStatus @default(ACTIVE)
  interval              BillingInterval           @default(MONTH)
  provider              String?
  providerSubscriptionId String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                   @default(false)
  canceledAt            DateTime?
  endedAt               DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         BillingPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     BillingInvoice[]

  @@unique([provider, providerSubscriptionId])
  @@index([organizationId, status, currentPeriodEnd])
  @@index([planId])
}

model BillingUsageEvent {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  entitlementKey String
  quantity       Int
  unit           String?
  idempotencyKey String
  metadata       Json?
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, entitlementKey, occurredAt])
  @@index([workspaceId, entitlementKey, occurredAt])
}

model BillingCreditEntry {
  id             String                @id @default(cuid())
  organizationId String
  workspaceId    String?
  entryType      BillingCreditEntryType
  direction      BillingCreditDirection
  amount         Int
  creditType     String
  idempotencyKey String
  reference      String?
  description    String?
  metadata       Json?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, creditType, occurredAt])
  @@index([workspaceId, creditType, occurredAt])
}

model BillingInvoice {
  id                 String              @id @default(cuid())
  organizationId     String
  subscriptionId     String?
  provider           String?
  providerInvoiceId  String?
  invoiceNumber      String?
  status             BillingInvoiceStatus @default(DRAFT)
  currency           String
  amountDueMinor     BigInt               @default(0)
  amountPaidMinor    BigInt               @default(0)
  amountRemainingMinor BigInt             @default(0)
  periodStart        DateTime?
  periodEnd          DateTime?
  dueAt              DateTime?
  issuedAt           DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     BillingPayment[]
  lines        BillingInvoiceLine[]

  @@unique([provider, providerInvoiceId])
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, createdAt])
  @@index([subscriptionId])
}

model BillingInvoiceLine {
  id               String                 @id @default(cuid())
  invoiceId        String
  lineType         BillingInvoiceLineType
  description      String
  quantity         Int
  unitAmountMinor  BigInt
  totalAmountMinor BigInt
  entitlementKey   String?
  metadata         Json?
  createdAt        DateTime               @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, lineType])
}

model BillingPayment {
  id                  String               @id @default(cuid())
  organizationId      String
  invoiceId           String?
  provider            String?
  providerPaymentId   String?
  status              BillingPaymentStatus @default(PENDING)
  currency            String
  amountMinor         BigInt
  refundedAmountMinor BigInt               @default(0)
  failureCode         String?
  failureMessage      String?
  paidAt              DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([organizationId, status, createdAt])
  @@index([invoiceId])
}

model BillingWebhookEvent {
  id              String             @id @default(cuid())
  organizationId  String?
  provider        String
  providerEventId String
  eventType       String
  payloadHash     String
  status          BillingWebhookStatus @default(RECEIVED)
  attemptCount    Int                @default(0)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  lastErrorCode   String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
}
