generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  ADVISOR
  VIEWER
}

enum EngagementStatus {
  DRAFT
  INTAKE
  ASSESSMENT
  PLANNING
  EXECUTION
  RECORDING
  VERIFICATION
  APPROVAL
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_EVIDENCE
  IN_REVIEW
  COMPLETE
  COMPLETED
  COMPLIANT
  OVERDUE
  BLOCKED
  WAIVED
  NOT_APPLICABLE
}

enum EvidenceClass {
  E0
  E1
  E2
  E3
  E4
  E0_UNKNOWN
  E1_USER_PROVIDED
  E2_SECONDARY
  E3_PRIMARY
  E4_CROSS_VERIFIED
}

enum ActivityType {
  CREATED
  UPDATED
  REVIEWED
  APPROVED
  COMPLETED
  COMMENTED
  STATUS_CHANGED
  DOCUMENT_ATTACHED
  NOTE
  STATUS_CHANGE
  DOCUMENT
  REPORT
  TASK
  APPROVAL
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  workspaces            Workspace[]
  clients               Client[]
  jurisdictions         Jurisdiction[]
  complianceObligations ComplianceObligation[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  assignedTasks Task[]       @relation("TaskAssignee")
  activities    Activity[]   @relation("ActivityActor")
}

model Membership {
  id             String   @id @default(cuid())
  role           UserRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients                 Client[]
  engagements             Engagement[]
  jurisdictions           Jurisdiction[]
  complianceItems         ComplianceItem[]
  settings                WorkspaceSettings?
  jurisdictionComparisons JurisdictionComparison[]
  formationPlans          FormationPlan[]
  workingDecisions        WorkingJurisdictionDecision[]
  complianceObligations   ComplianceObligation[]
  documents               Document[]
  reports                 Report[]
  activities              Activity[]
  tasks                   Task[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Client {
  id               String   @id @default(cuid())
  organizationId   String?
  workspaceId      String
  name             String?
  firstName        String?
  lastName         String?
  organizationName String?
  email            String?
  phone            String?
  country          String?
  proposedBusiness String?
  intakeData       Json?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessProfile       BusinessProfile?
  formationPlans        FormationPlan[]
  complianceObligations ComplianceObligation[]
  engagements           Engagement[]
  documents             Document[]
  reports               Report[]

  @@index([workspaceId])
}

model BusinessProfile {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  businessName        String?
  businessType        String?
  businessObjective   String?
  businessModel       String?
  targetMarket        String?
  revenueModel        String?
  ownershipContext    String?
  fundingStage        String?
  expansionObjectives String?
  constraints         String?
  strategicNotes      String?
  operationalContext  String?
  data                Json?
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formationPlans FormationPlan[]
}

model Engagement {
  id          String           @id @default(cuid())
  workspaceId String
  clientId    String
  service     String
  status      EngagementStatus @default(DRAFT)
  nextAction  String?
  ownerId     String?
  startedAt   DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks           Task[]
  reports         Report[]
  activities      Activity[]
  complianceItems ComplianceItem[]
  roadmap         FormationRoadmap?

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
}

model Jurisdiction {
  id             String    @id @default(cuid())
  organizationId String?
  workspaceId    String?
  name           String
  country        String
  code           String?
  countryCode    String?
  description    String?
  profile        Json?
  reviewDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization?                 @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace             Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  evidence              Evidence[]
  roadmap               FormationRoadmap[]
  observations          JurisdictionObservation[]
  workingDecisions      WorkingJurisdictionDecision[]
  formationPlans        FormationPlan[]
  complianceObligations ComplianceObligation[]

  @@index([workspaceId])
  @@index([country])
}

model FormationRoadmap {
  id             String   @id @default(cuid())
  engagementId   String?  @unique
  clientId       String?
  jurisdictionId String?
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jurisdiction Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  engagement   Engagement?     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  steps        FormationStep[]
}

model FormationStep {
  id          String    @id @default(cuid())
  roadmapId   String
  sequence    Int
  title       String
  description String?
  completed   Boolean   @default(false)
  dueAt       DateTime?

  roadmap FormationRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, sequence])
}

model ComplianceItem {
  id           String           @id @default(cuid())
  engagementId String?
  workspaceId  String
  clientId     String?
  title        String
  category     String?
  jurisdiction String?
  status       ComplianceStatus @default(NOT_STARTED)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@index([workspaceId])
  @@index([status])
  @@index([dueAt])
}

model Evidence {
  id               String        @id @default(cuid())
  title            String
  source           String?
  sourceType       String?
  publicationDate  DateTime?
  retrievedAt      DateTime?
  evidenceClass    EvidenceClass @default(E0_UNKNOWN)
  confidence       Int?
  reviewStatus     String?
  notes            String?
  jurisdictionId   String?
  complianceItemId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  jurisdiction   Jurisdiction?   @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  complianceItem ComplianceItem? @relation(fields: [complianceItemId], references: [id], onDelete: SetNull)
  documents      Document[]

  @@index([evidenceClass])
  @@index([jurisdictionId])
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  evidenceId  String?
  name        String
  mimeType    String?
  storageKey  String?
  sizeBytes   Int?
  checksum    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  evidence  Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
}

model Report {
  id           String   @id @default(cuid())
  workspaceId  String
  clientId     String?
  engagementId String?
  title        String
  format       String?
  status       String?
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([clientId])
  @@index([engagementId])
}

model Activity {
  id           String       @id @default(cuid())
  engagementId String?
  workspaceId  String
  actorId      String?
  type         ActivityType @default(SYSTEM)
  title        String
  summary      String?
  description  String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([engagementId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  workspaceId  String
  engagementId String?
  assigneeId   String?
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  engagement Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([assigneeId])
  @@index([dueAt])
}

model WorkspaceSettings {
  id                          String   @id @default(cuid())
  workspaceId                 String   @unique
  timezone                    String   @default("UTC")
  defaultLandingPage          String   @default("/command-center")
  complianceReminderDays      Int      @default(30)
  notificationsEnabled        Boolean  @default(true)
  complianceDueNotifications  Boolean  @default(true)
  evidenceReviewNotifications Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model JurisdictionObservation {
  id             String       @id @default(cuid())
  jurisdictionId String
  criterionKey   String
  value          Float
  evidenceIds    String[]
  assumptions    String[]
  reviewRequired Boolean      @default(false)
  createdAt      DateTime     @default(now())
  jurisdiction   Jurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)

  @@index([jurisdictionId, criterionKey])
}

model JurisdictionComparison {
  id                  String   @id @default(cuid())
  workspaceId         String
  businessProfileId   String?
  methodologyVersion  String
  criteriaJson        String
  jurisdictionIdsJson String
  resultsJson         String
  createdAt           DateTime @default(now())

  workspace        Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workingDecisions WorkingJurisdictionDecision[]

  @@index([workspaceId, createdAt])
  @@index([businessProfileId, createdAt])
}

model WorkingJurisdictionDecision {
  id                          String   @id @default(cuid())
  workspaceId                 String
  businessProfileId           String
  comparisonSnapshotId        String
  jurisdictionId              String
  rationale                   String?
  decidedByUserId             String
  decidedAt                   DateTime @default(now())
  professionalReviewRequired  Boolean  @default(true)
  professionalReviewCompleted Boolean  @default(false)

  workspace          Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comparisonSnapshot JurisdictionComparison @relation(fields: [comparisonSnapshotId], references: [id], onDelete: Cascade)
  jurisdiction       Jurisdiction           @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  formationPlans     FormationPlan[]

  @@index([workspaceId, businessProfileId])
  @@index([jurisdictionId])
}

model FormationPlan {
  id                            String   @id @default(cuid())
  workspaceId                   String
  clientId                      String
  businessProfileId             String
  comparisonSnapshotId          String
  workingJurisdictionDecisionId String
  jurisdictionId                String
  jurisdictionName              String
  methodologyVersion            String
  status                        String   @default("DRAFT")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  workspace                   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                      Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessProfile             BusinessProfile             @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  workingJurisdictionDecision WorkingJurisdictionDecision @relation(fields: [workingJurisdictionDecisionId], references: [id])
  jurisdiction                Jurisdiction                @relation(fields: [jurisdictionId], references: [id])
  stages                      FormationStage[]
  complianceObligations       ComplianceObligation[]

  @@index([workspaceId, createdAt])
  @@index([clientId])
  @@index([businessProfileId])
  @@index([jurisdictionId])
}

model FormationStage {
  id              String   @id @default(cuid())
  formationPlanId String
  key             String
  title           String
  description     String
  order           Int
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  formationPlan FormationPlan   @relation(fields: [formationPlanId], references: [id], onDelete: Cascade)
  tasks         FormationTask[]

  @@unique([formationPlanId, key])
  @@index([formationPlanId, order])
}

model FormationTask {
  id                         String    @id @default(cuid())
  formationStageId           String
  key                        String
  title                      String
  description                String
  order                      Int
  status                     String    @default("PENDING")
  dependsOnTaskKeys          String[]
  requiresProfessionalReview Boolean   @default(false)
  blockingReason             String?
  completionNote             String?
  completedAt                DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  formationStage       FormationStage                 @relation(fields: [formationStageId], references: [id], onDelete: Cascade)
  evidenceRequirements FormationEvidenceRequirement[]
  reviews              FormationReview[]

  @@unique([formationStageId, key])
  @@index([formationStageId, order])
}

model FormationEvidenceRequirement {
  id              String    @id @default(cuid())
  formationTaskId String
  key             String
  label           String
  required        Boolean   @default(true)
  satisfied       Boolean   @default(false)
  evidenceId      String?
  satisfiedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  formationTask FormationTask @relation(fields: [formationTaskId], references: [id], onDelete: Cascade)

  @@unique([formationTaskId, key])
}

model FormationReview {
  id              String   @id @default(cuid())
  formationTaskId String
  reviewerUserId  String
  outcome         String
  note            String?
  reviewedAt      DateTime @default(now())

  formationTask FormationTask @relation(fields: [formationTaskId], references: [id], onDelete: Cascade)

  @@index([formationTaskId, reviewedAt])
}

model ComplianceObligation {
  id                          String           @id @default(cuid())
  organizationId              String
  workspaceId                 String
  clientId                    String
  businessProfileId           String?
  formationPlanId             String?
  jurisdictionId              String?
  sourceRuleId                String?
  title                       String
  description                 String?
  type                        String
  status                      ComplianceStatus @default(NOT_STARTED)
  dueAt                       DateTime?
  completedAt                 DateTime?
  ownerUserId                 String?
  professionalReviewRequired  Boolean          @default(false)
  professionalReviewCompleted Boolean          @default(false)
  escalationLevel             Int              @default(0)
  requiresEvidence            Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formationPlan FormationPlan?       @relation(fields: [formationPlanId], references: [id], onDelete: SetNull)
  jurisdiction  Jurisdiction?        @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  activities    ComplianceActivity[]
  reminders     ComplianceReminder[]
  evidence      ComplianceEvidence[]

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([clientId])
}

model ComplianceActivity {
  id           String   @id @default(cuid())
  obligationId String
  action       String
  actorUserId  String?
  note         String?
  metadata     Json?
  createdAt    DateTime @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId, createdAt])
}

model ComplianceReminder {
  id           String    @id @default(cuid())
  obligationId String
  scheduledFor DateTime
  channel      String
  message      String
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, sentAt])
}

model ComplianceEvidence {
  id            String   @id @default(cuid())
  obligationId  String
  documentId    String
  evidenceClass String
  note          String?
  createdAt     DateTime @default(now())

  obligation ComplianceObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@index([obligationId])
}
